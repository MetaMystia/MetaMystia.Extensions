{
	"explorer.fileNesting.enabled": true,
	"explorer.fileNesting.expand": false,
	"explorer.fileNesting.patterns": {
		"MetaMystia.Extensions.sln": "*.props, *.targets, NuGet.config, .editorconfig, .gitattributes, .gitignore, build.ps1",
		"README*": "*.md, LICENSE",
		"*.csproj": "FodyWeavers.xml, FodyWeavers.xsd, packages.lock.json"
